rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── shops collection — public read, no write from client ─────────────────
    // The shops directory is intentionally public-read: the home screen loads
    // categories without requiring authentication (rural users may not have
    // accounts). All writes must go through the Firebase Admin SDK / console.
    match /shops/{shopId} {
      allow read:  if true;
      allow write: if false;  // Admin-only via console or Cloud Functions
    }

    // ── Deny everything else by default ──────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
